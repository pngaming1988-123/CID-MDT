# Copy this file to .env and fill it in.

# Same connection string as the FiveM server's `mysql_connection_string`
# (server.cfg) if you want the in-game Evidence Lab results to show up here.
DATABASE_URL=mysql://user:password@host:3306/database?charset=utf8mb4

PORT=3000

# true once the site is served over HTTPS
COOKIE_SECURE=false

# 1 when running behind a reverse proxy (nginx, Cloudflare tunnel, etc.)
TRUST_PROXY=
